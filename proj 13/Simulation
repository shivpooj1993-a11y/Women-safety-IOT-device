#define SOS_PIN 27
#define BUZZER_PIN 26
#define LED_PIN 2

bool emergency = false;

void setup()
{
  Serial.begin(115200);

  pinMode(SOS_PIN, INPUT_PULLUP);
  pinMode(BUZZER_PIN, OUTPUT);
  pinMode(LED_PIN, OUTPUT);

  digitalWrite(BUZZER_PIN, LOW);
  digitalWrite(LED_PIN, LOW);

  Serial.println("Women Safety IoT Simulation");
  Serial.println("System Ready");
}

void loop()
{
  if (digitalRead(SOS_PIN) == LOW && !emergency)
  {
    emergency = true;

    Serial.println();
    Serial.println("================================");
    Serial.println("EMERGENCY DETECTED");
    Serial.println("SOS BUTTON PRESSED");
    Serial.println("================================");

    Serial.println("GPS: 15.828125, 78.037270");
    Serial.println("Emergency location obtained.");

    Serial.println("Generating emergency SMS...");
    Serial.println("EMERGENCY ALERT!");
    Serial.println("SOS button activated.");
    Serial.println("Location: 15.828125, 78.037270");

    digitalWrite(BUZZER_PIN, HIGH);
    digitalWrite(LED_PIN, HIGH);

    delay(1000);

    digitalWrite(BUZZER_PIN, LOW);
    digitalWrite(LED_PIN, LOW);
  }

  delay(50);
}
